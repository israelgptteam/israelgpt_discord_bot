# Discord bot token - create an application + bot at https://discord.com/developers/applications
# Under Bot settings, enable the "Message Content" privileged intent (required to read message text).
DISCORD_BOT_TOKEN=your_discord_bot_token_here

# IsraelGPT API key - get one at https://www.israelgpt.site/dashboard (requires a free account)
ISRAELGPT_API_KEY=igpt_live_your_api_key_here

# Optional - defaults to the production API. Override for local testing against `npm run dev`.
ISRAELGPT_API_BASE_URL=https://www.israelgpt.site/api/v1

# Optional - a Discord server (guild) ID. If set, slash commands sync instantly to that one
# server for testing. Without it, commands sync globally, which can take up to ~1 hour to
# appear in Discord's UI after the bot starts.
DISCORD_DEV_GUILD_ID=
